{
  "expo": {
    "name": "玩天气",
    "slug": "play-weather-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "scheme": "playweather",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.playweather.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0B0B10"
      },
      "package": "com.playweather.app"
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png",
      "meta": {
        "viewport": "width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no"
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "Play Weather needs access to your photos so you can share your sky photography with the community."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "1015e517-11ad-469d-8b66-b8dec49c58c0"
      }
    },
    "owner": "stevenzhus-team"
  }
}
