# ====== 玩天气 App 环境变量配置清单 ======
# 使用方式：
# 1. 本地开发：复制此文件为 .env.local，填入实际值
# 2. Vercel 生产：在 Vercel Dashboard → Settings → Environment Variables 中设置

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# 和风天气认证（二选一，推荐 JWT）
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# 【推荐】Ed25519 JWT 签名（企业版 BFF 代理用）
# 私钥 PEM（多行转为一行，\n 分隔）；kid 与 projectId 从和风控制台获取
QWEATHER_ED25519_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\nMC4CAQAwBQYDK2VwBCIEIDCXhhEFWdqR8ET7e0zSxLLx/md6/Rh+X0a7cAmzJBRQ\n-----END PRIVATE KEY-----
QWEATHER_KID=your_kid_here
QWEATHER_PROJECT_ID=your_project_id_here

# 【回退】和风天气 API Key（本地开发或过渡用）
# 从 https://console.qweather.com 获取
# ⚠️ 请勿在模板/示例文件中填写真实 Key！真实值只写入 .env.local（已被 .gitignore 忽略）
QWEATHER_API_KEY=your_qweather_api_key_here

# 和风天气 API 基础 URL（可选，默认 https://api.qweather.com/v7）
QWEATHER_BASE_URL=https://m85ctw7p24.re.qweatherapi.com/v7

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# 其他服务
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# JWT 签名密钥（用户登录态，非天气认证）
# 生成方式：node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=play-weather-dev-secret-change-in-production

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# Supabase（S1 后端选型）
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# 从 Supabase Dashboard → Project Settings → API 获取
EXPO_PUBLIC_SUPABASE_URL=https://xxxxxx.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# 生成方式：node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=play-weather-dev-secret-change-in-production
